{
  "name": "pitchlens-functions",
  "description": "Firebase Cloud Functions for Pitchlens",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.7.2",
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "typescript": "^5.5.3"
  },
  "private": true,
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
