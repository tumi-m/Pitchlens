ENV=development
API_SECRET_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
ROBOFLOW_API_KEY=
ROBOFLOW_PROJECT=football-players-detection-3zvbc
ROBOFLOW_VERSION=9
ENABLE_EXPERIMENTAL_ANALYTICS=false
ALLOWED_ORIGINS=http://localhost:3000
FRAME_SUBSAMPLE=5
PIPELINE_WORKERS=2

# Vision worker (app.vision.server). Hosted defaults live in vision.Dockerfile.
VISION_SERVICE_TOKEN=
VISION_DATA_DIR=.vision
VISION_ALLOWED_HOSTS=127.0.0.1,localhost
VISION_RETENTION_HOURS=
VISION_UPLOAD_IDLE_SECONDS=300
VISION_THREADS=
VISION_DEVICE=cpu
VISION_MODEL_PATH=models/yolo11s.pt
VISION_BALL_MODEL_PATH=models/football-ball.onnx
